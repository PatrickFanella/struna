{
  "name": "struna",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"server/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "build": "pnpm run typecheck && vite build",
    "start": "NODE_ENV=production node server/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.9.0",
    "epubjs": "^0.3.93",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
